<?xml version="1.0"?>
<ruleset name="FormCourier CRM">
    <description>WordPress Coding Standards configuration for FormCourier CRM.</description>

    <file>formcourier-crm.php</file>
    <file>uninstall.php</file>
    <file>includes</file>
    <file>assets</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>release/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>tools/*</exclude-pattern>
    <exclude-pattern>documentation/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress"/>
    <rule ref="WordPress-Docs"/>

    <config name="minimum_supported_wp_version" value="6.2"/>
    <config name="text_domain" value="formcourier-crm"/>
    <config name="prefixes" value="formcourier_crm,FORMCOURIER_CRM,FormCourier_CRM"/>
</ruleset>
